{
  "name": "create-dsh",
  "version": "0.1.0",
  "description": "Generator-first scaffolding for DeepSeek Harness plugins (template overlay architecture)",
  "homepage": "https://github.com/zaeyee/create-dsh#readme",
  "bugs": {
    "url": "https://github.com/zaeyee/create-dsh/issues"
  },
  "license": "MIT",
  "author": "zaeyee <zaeyee@163.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zaeyee/create-dsh.git"
  },
  "bin": {
    "create-dsh": "./dist/index.mjs"
  },
  "files": [
    "dist",
    "template",
    "locales",
    "README.md",
    "README.zh.md"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "create": "node src/index.ts",
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@clack/prompts": "^1.7.0",
    "@types/node": "^26.1.1",
    "bumpp": "^11.1.0",
    "ejs": "^6.0.1",
    "picocolors": "^1.1.1",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.25.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "inlinedDependencies": {
    "@clack/core": "1.4.3",
    "@clack/prompts": "1.7.0",
    "ejs": "6.0.1",
    "fast-string-truncated-width": "3.0.3",
    "fast-string-width": "3.0.2",
    "fast-wrap-ansi": "0.2.2",
    "picocolors": "1.1.1",
    "sisteransi": "1.0.5"
  }
}
